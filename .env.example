# Copy to .env.local for local development. Never commit .env.local.
#
# These two are public by design. Use the DEV project's values locally and in
# Vercel's Preview and Development environments; use PROD only in Production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secrets are added later, as features need them, and only ever in Vercel's
# settings or .env.local. Never in chat, the Life Hub doc, Linear or git.
# SUPABASE_SECRET_KEY=
# ANTHROPIC_API_KEY=
